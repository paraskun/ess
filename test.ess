func mean(v f64) f64 {
  var c := 0.0;
  var s := 0.0;

  c = c + 1.0;
  s = s + v;

  return s / c;
}

type event {
  dev u64
  val f64
}

func map(e event) u64 {
  return e.dev;
}

type result {
  dev u64
  mean f64
}

func reduce(e event) result {
  var r = result {
    dev: e.dev,
    mean: mean(e.val)
  };

  return r;
}
